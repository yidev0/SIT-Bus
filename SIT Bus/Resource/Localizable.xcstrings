    "SchoolBusIwatsukiWeekday.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operates every weekday **except** on open campus, parents' meeting, entrance exams, and vacations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オープンキャンパス、父母懇談会、共通テスト、入試、夏季冬季一斉休暇**以外**運行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除开放校园、父母恳谈会、大学入学共通考试、入学考试以及暑期和冬期统一休假期间**以外**，每个工作日运行"
          }
        }
      }
    },
