      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operates every weekday **except** on open campus, parents' meeting, entrance exams, and vacations."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オープンキャンパス、父母懇談会、共通テスト、入試、夏季冬季一斉休暇**以外**運行"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个工作日运行，**但不包括**校园开放日、家长会、大学入学共通考试、入学考试以及暑假和寒假统一休假期间。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opera todos los días laborables, **excepto** durante jornadas de puertas abiertas, reuniones de padres, el examen común de ingreso a la universidad, exámenes de ingreso y cierres de verano e invierno."
          }
        }
      }
