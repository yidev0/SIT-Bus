    "BusWheelchairInfo.detail" : {
      "comment" : "Wheelchair accessibility note shown in the timetable information sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most buses operating are wheelchair-accessible, with support for ramps and assistance by the driver. \n100th anniversary design wrapped bus, is not wheelchair-accessible. Please contact Section of Campus Facility for details on operating hours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "創立100周年記念ラッピングのバス以外、全てのバスが車椅子対応をしています。乗車時にサポートが必要な方は運転手にお声がけください。\n各車両の運行時間は大宮キャンパスの管理課にお問い合わせください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除创立100周年纪念涂装巴士外，所有巴士均支持轮椅乘车。乘车时需要协助的乘客，请告知驾驶员。\n各车辆的运行时间请咨询大宫校区管理课。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excepto el autobús rotulado con el diseño del 100.º aniversario, todos los autobuses son accesibles para sillas de ruedas. Si necesitas asistencia al subir, avisa al conductor.\nPara consultar los horarios de servicio de cada vehículo, contacta con la oficina de administración del campus de Omiya."
          }
        }
      }
    },
