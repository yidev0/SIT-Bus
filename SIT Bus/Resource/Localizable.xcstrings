    "FeatureWidget.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place widgets on your home screen to check the departure time of the next bus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面から次のバスの発車時刻を確認できます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主屏幕放置小组件，即可确认下一班巴士的发车时间"
          }
        }
