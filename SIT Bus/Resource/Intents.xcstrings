    "BusRoute.Disambiguation" : {
      "comment" : "Prompt asking the user to choose a bus route.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Which bus route?" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Qué ruta de autobús?" } },
