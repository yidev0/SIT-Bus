{
  "sourceLanguage" : "en",
  "strings" : {
    "GetNextBus.Description" : {
      "comment" : "App Intent description for finding the next school bus departure from a selected bus type and date.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find the next exact bus departure for a selected route and date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca la próxima salida exacta para una ruta y fecha seleccionadas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定したバス路線と日付から、次の定刻出発を探します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查找所选巴士路线和日期的下一班定时发车。"
          }
        }
      }
    },
    "GetNextBus.Title" : {
      "comment" : "App Intent title shown in Shortcuts for finding the next school bus departure time.",
