        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请选择巴士路线。" } }
      }
    },
    "GetNextBus.Error.TimelyOperation" : {
      "comment" : "Intent error shown when the route is operating continuously and has no exact departure time.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This route is operating continuously, so there is no exact departure time." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta ruta funciona de forma continua, por lo que no hay una hora de salida exacta." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この路線は適時運行中のため、正確な発車時刻はありません。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该路线正在连续运行，因此没有确切的发车时间。" } }
      }
    },
    "GetNextBus.Success.Dialog" : {
      "comment" : "Dialog shown when an exact next departure is found. Keep the %@ placeholder for the formatted departure date.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The next bus departs at %@." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El próximo autobús sale a las %@." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "次のバスは%@に発車します。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下一班巴士于%@发车。" } }
      }
    },
