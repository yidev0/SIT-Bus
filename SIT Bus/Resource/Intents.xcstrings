{
  "sourceLanguage": "en",
  "strings": {
    "GetNextBus.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the next school bus departure time from specified bus type and date."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定されたバスの種類と日付から次のスクールバスの出発時間を探す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据指定的巴士类型和日期查找下一班校车的发车时间。"
          }
        }
      }
    },
    "GetNextBus.Title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find Next School Bus Time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のスクールバスの発車時刻"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找下一班校车时间"
          }
        }
      }
    },
    "NextSchoolBusFrom${date}.Summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the next school bus from ${date}"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "${date}から次のスクールバスの発車時刻"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找${date}之后的下一班校车发车时间"
          }
        }
      }
    }
  },
  "version": "1.0"
}
