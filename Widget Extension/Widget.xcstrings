        }
      },
      "comment": "Widget status label for a route that runs during a time window instead of fixed departures."
    },
    "TimelyOperation(%@,%@)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to %2$@"
