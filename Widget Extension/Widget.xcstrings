          "stringUnit": {
            "state": "translated",
            "value": "显示所选校车的下一班发车时间"
          }
        }
      },
      "comment": "Widget gallery description explaining that the widget shows the next selected school bus departure."
    },
    "TimelyOperation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timely Operation"
          }
        },
