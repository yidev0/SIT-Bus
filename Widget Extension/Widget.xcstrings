    "SITBusWidget.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displays the next departure time of the selected school bus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定したスクールバスの次の発車時間を表示"
