        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@から%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@到%2$@"
          }
        }
      },
      "comment": "Widget time range for timely operation. Keep the %1$@ and %2$@ placeholders for start and end times."
